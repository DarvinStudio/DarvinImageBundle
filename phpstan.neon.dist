includes:
    - phpstan-baseline.neon
parameters:
    level: 5
    phpVersion:
        min: 70200
        max: 80400
    excludePaths:
        - */Tests/*
        - */vendor/*
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # False positive caused by the analysis environment: Symfony >= 6 declares a native "mixed $data" on
        # JsonResponse::__construct(), which PHPStan reads as a class named Symfony\Component\HttpFoundation\mixed
        # because phpVersion.min is 7.2. Not reported when analysing against Symfony 5.x, hence reportUnmatched: false.
        -
            message: '#^Parameter \#1 \$data of class Symfony\\Component\\HttpFoundation\\JsonResponse constructor expects Symfony\\Component\\HttpFoundation\\mixed\|null, array<string, list<int\|null>> given\.$#'
            identifier: argument.type
            count: 1
            reportUnmatched: false
            path: Controller/Image/ExterminateController.php
