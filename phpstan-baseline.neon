            count: 1
            path: ORM/ImageJoiner.php
        -
            message: '#^Trait Darvin\\ImageBundle\\Traits\\ImageableRepositoryTrait is used zero times and is not analysed\.$#'
            identifier: trait.unused
            count: 1
            path: Traits/ImageableRepositoryTrait.php
